generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now())
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String
  createdAt   DateTime @default(now())
  featured    Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model Portfolio {
  id           Int     @id @default(autoincrement())
  title        String
  category     String
  description  String
  image        String
  technologies String
  projectUrl   String?
  githubUrl    String?

  active   Boolean @default(true)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
}

model SiteSettings {
  id Int @id @default(1)

  // Company

  companyName String
  tagline     String

  // Hero

  heroTitle    String
  heroSubtitle String

  heroButtonText String
  heroButtonLink String

  heroImage String

  heroCard1Title String @default("Experience")
  heroCard1Text  String @default("170+ Professional Services")

  heroCard2Title String @default("Coverage")
  heroCard2Text  String @default("Serving Kenya & Beyond")

  // About

  aboutTitle       String
  aboutDescription String

  // Contact

  phone   String
  email   String
  address String

  // Social

  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  github    String?

  // Footer

  footerText String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  username String? @unique

  password String

  role String? @default("Administrator")

  active Boolean? @default(true)

  lastLogin DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now())

  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(6)
}

model Testimonial {
  id Int @id @default(autoincrement())

  name String

  position String

  company String

  message String

  rating Int @default(5)

  image String @default("/avatar.png")

  featured Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SiteStats {
  id Int @id @default(autoincrement())

  value String

  label String

  order Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model WhyChoose {
  id Int @id @default(autoincrement())

  title String

  description String

  icon String

  order Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ProcessStep {
  id Int @id @default(autoincrement())

  title String

  description String

  stepNumber Int

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Partner {
  id Int @id @default(autoincrement())

  name String

  logo String

  website String?

  featured Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FAQ {
  id Int @id @default(autoincrement())

  question String

  answer String @db.Text

  featured Boolean @default(true)

  order Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model CallToAction {
  id Int @id @default(1)

  title String

  subtitle String

  buttonText String

  buttonLink String

  phone String

  email String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
